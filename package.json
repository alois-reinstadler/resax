{
	"name": "resax",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm registry:build && vite build",
		"registry:build": "shadcn-svelte registry build registry.json -o static/r",
		"registry:check": "tsx scripts/check-registry.ts",
		"consumer:smoke": "node scripts/consumer-smoke.mjs",
		"api:build": "node scripts/generate-api.mjs",
		"api:check": "node scripts/generate-api.mjs --check",
		"docs:check": "node scripts/check-docs.mjs",
		"references:check": "node scripts/organize-references.mjs --check",
		"fidelity:check": "node scripts/check-fidelity.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:a11y": "playwright test tests/e2e/docs-a11y.spec.ts",
		"test:visual": "playwright test tests/e2e/docs-visual.spec.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.33.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/svelte": "^5.4.2",
		"clsx": "^2.1.1",
		"jsdom": "^30.0.1",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.20.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.3",
		"@tanstack/table-core": "^9.1.2",
		"bits-ui": "^2.19.0",
		"shiki": "^4.4.3"
	}
}
